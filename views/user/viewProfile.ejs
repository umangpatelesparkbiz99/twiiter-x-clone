<!DOCTYPE html>
<html lang="en">
<%- include('../global/header') %>
<body>
    
    <div class="container-fluid justify-content-between">
        <div class="container ">
            <div class="row">

                <%- include('../global/leftPannal') %>


                    <div class="col-lg-6 col-8 text-white border-start border-end border-secondary min-vh-100 p-0">
                        <div class="d-flex justify-content-left text-align-center fs-4 mt-2 sticky-top" style=" background: rgba(255, 255, 255, 0.085);backdrop-filter: blur(12px)">
                            <a class="btn btn-outline-none text-white x-btn " href="/home">
                                <i class="fa-solid fa-arrow-left"></i>
                            </a>
                            <span>Back</span>
                            <hr class="mt-0">
                        </div>
                        <!-- Header Section -->
                        <div class="position-relative">
                            <!-- Cover Image -->

                            <img src="<%= user?.cover_image!== null ?(" /"+user?.cover_image)
                                : 'https://static.vecteezy.com/system/resources/thumbnails/049/148/189/small/natural-green-background-from-young-green-leaves-fresh-green-leaves-covering-the-wall-photo.jpg'
                                %>"
                            alt="cover" class="w-100 object-fit-cover" style="height: 200px;">

                            <!-- Profile Image (Absolute) -->
                            <div class="position-absolute start-0  ms-3" style="bottom: -50px; z-index: 5;">
                                <img src="<%= (user?.profile_image)!== null ? (" /"+user?.profile_image)
                                    : 'https://upload.wikimedia.org/wikipedia/commons/0/03/Twitter_default_profile_400x400.png'
                                    %>"
                                alt="profile" class="rounded-circle border border-4 border-dark bg-dark"
                                style="width: 130px; height: 130px; object-fit: cover;">
                            </div>
                        </div>

                        <!-- Action Button Row -->
                        <div class="d-flex justify-content-end p-3" style="height: 60px;">
                            <button type="button"
                                class="btn btn-outline-light rounded-pill fw-bold d-inline-flex align-items-center justify-content-center px-4 py-2"
                                id="followbtn" onclick="getFollow(`<%= user.username %>`,`<%= reqUser%>`)">
                                <% if (isfollower) { %>
                                    Unfollow
                                    <% } else { %>
                                        Follow
                                        <% } %>
                            </button>
                        </div>

                        <!-- User Info Section -->
                        <div class="px-3 mt-3">
                            <div class="mb-3">
                                <h4 class="fw-bold mb-0">
                                    <%= user?.name %>
                                        <%= user?.lastname %>
                                </h4>
                                <p class="text-secondary mb-2">@<%= user?.username %>
                                </p>
                            </div>

                            <p class="text-white mb-3">
                                <%= user?.bio || "No bio yet." %>
                            </p>

                            <!-- Stats (Followers/Following) -->
                            <div class="row">
                                <div class="col">

                                    <div class="d-flex gap-3 mb-3">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-bold text-white" id="followingCtn">
                                                <%= totalFollowing %>
                                            </span>
                                            <span class="text-secondary">Following</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-bold text-white" id="followerCtn">
                                                <%= totalFollower %>
                                            </span>
                                            <span class="text-secondary">Followers</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col ">
                                    <div class="d-flex gap-3 mb-3">
                                        <div class="d-flex align-items-center gap-1">
                                            <span>
                                                <i class="fa-solid fa-calendar"></i>
                                                Joined at -
                                                <%= new Date(user.created_at).toLocaleString(undefined, {
                                                    dateStyle: 'medium' });%>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nav Tabs (Tweets, Replies, etc) -->
                        <div class="d-flex justify-content-around border-bottom mb-3 border-secondary mt-2">
                            <div class="p-3 fw-bold border-bottom border-primary border-4">Posts</div>
                            <div class="p-3 text-secondary">comments</div>
                            <div class="p-3 text-secondary">Likes</div>
                        </div>
                        <!-- <hr> -->

                        <% let count = 0 %>
                        <!-- Load all post here  -->
                        <% all_feed.forEach(feed=> { %>

                            <div class="container-fluid">
                                <div class="container">
                                    <div class="container">

                                        <!-- User info who post this twitt -->
                                        <div class="row align-items-center text-white g-2">
                                            <!-- 1. Profile Photo  -->
                                            <div class="col-auto">
                                                <img src="<%= feed?.profile_image !==null ?(" /"+feed?.profile_image)
                                                    : 'https://upload.wikimedia.org/wikipedia/commons/0/03/Twitter_default_profile_400x400.png'
                                                    %>"
                                                alt="profile" class="rounded-circle border border-2 border-dark"
                                                style="width: 45px; height: 45px; object-fit: cover;">
                                            </div>

                                            <!-- 2. Name and Username (Stays right next to photo) -->
                                            <div class="col-auto d-flex flex-column lh-sm">
                                                <span class="fw-bold small">
                                                    <%= feed?.name %>
                                                        <%= feed?.lastname %>
                                                </span>
                                                <span class="text-secondary x-small" style="font-size: 0.85rem;">
                                                    @<%= feed?.username %>
                                                </span>
                                            </div>

                                            <!-- 3. Post Date (Pushed to the far end) -->
                                            <div class="col text-end ms-auto">
                                                <span class="text-secondary small">just now</span>
                                            </div>
                                        </div>
                                        <hr class="mt-1 ">

                                        <!-- content of this twitt with img if provided -->
                                        <div class="container d-flex flex-column">
                                            <p>
                                                <%= feed.content %>
                                            </p>
                                            <% if (feed.retweet_content) { %>
                                                <p>
                                                    <%= feed.retweet_content %>
                                                </p>
                                                <% if (feed.retweet_content_image) { %>
                                                    <div class="container d-flex justify-content-center " style="height: 300px; width: 300px;">
                                            
                                                        <img src="<%= ("/"+feed.retweet_content_image) || 'https://images.unsplash.com/photo-1715146303917-835a41f452d0?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' %>"
                                                        alt="userPost" class="img-fluid object-fit-scale rounded mx-auto d-block">
                                                    </div>
                                                    <% } %>
                                                <% } %>
                                            <% if (feed?.content_image) { %>

                                                <div class="container d-flex justify-content-center "
                                                    style="height: 300px; width: 300px;">

                                                    <img src="<%= (" /"+feed.content_image)!=null ?
                                                        ("/"+feed.content_image): 'https://images.unsplash.com/photo-1715146303917-835a41f452d0?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'
                                                        %>"
                                                    alt="userPost-Image" class="img-fluid object-fit-scale rounded
                                                    mx-auto
                                                    d-block">
                                                </div>
                                                <hr>
                                                <% } %>

                                        </div>
                                        <div class="container">
                                            <div class="row">
                                                <!-- Like Button -->
                                                <div class="col-3 d-flex align-items-center">
                                                    <button type="button"
                                                        class="btn fs-5 text-white d-flex align-items-center"
                                                        onclick="likeUnlikePost('<%= feed.tweet_uni_id %>','<%= user.uni_id %>','<%= count %>')"
                                                        id="liketweet">

                                                        
                                                        <% if (feed.isLikedByUser) { %>
                                                            <i class="fa-solid fa-heart me-2 text-danger" id="liketweetIcn<%=count%>"></i>
                                                        
                                                            <% } else { %>
                                                                <i class="fa-regular fa-heart me-2" id="liketweetIcn<%=count%>"></i>
                                                                <% } %>
                                                        <span class="fs-6" id="liketweetCtn<%=count%>">
                                                            <%= feed.total_likes || 0 %>
                                                        </span>
                                                    </button>
                                                </div>

                                                <!-- Share Button -->
                                                <div class="col-3 d-flex align-items-center">
                                                    <button type="button"
                                                        class="btn fs-5 text-white d-flex align-items-center">
                                                        <i class="fa-regular fa-share-from-square me-2"></i>
                                                        <span class="fs-6">
                                                            <%= feed.sharesCount || 0 %>
                                                        </span>
                                                    </button>
                                                </div>

                                                <!-- Retweet Button -->
                                                <div class="col-3 d-flex align-items-center">
                                                    <button type="button"
                                                        class="btn fs-5 text-white d-flex align-items-center">
                                                        <i class="fa-solid fa-retweet me-2"></i>
                                                        <span class="fs-6">
                                                            <%= feed.retweetsCount || 0 %>
                                                        </span>
                                                    </button>
                                                </div>

                                                <!-- Comment Button -->
                                                <div class="col-3 d-flex align-items-center">
                                                    <button type="button"
                                                        class="btn fs-5 text-white d-flex align-items-center">
                                                        <i class="fa-regular fa-comment me-2"></i>
                                                        <span class="fs-6">
                                                            <%= feed.commentsCount || 0 %>
                                                        </span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <hr>
                                    </div>

                                </div>
                            </div>
                            <% count++;}) %>

                    </div>

                    <%- include('../global/rightPannal') %>

            </div>
        </div>
    </div>
    </body>

</html>