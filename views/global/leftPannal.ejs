<!-- Desktop Sidebar (visible md and up) -->
    <div
        class="col-2 col-lg-3 d-none d-md-flex flex-column align-items-center align-items-lg-start border-end sticky-top px-2 vh-100 bg-black">
    
        <!-- Logo -->
        <a href="/home" class="mb-3 text-white fs-3 px-2 mt-3">
            <i class="fa-brands fa-x-twitter m-0"></i>
        </a>
    
        <!-- Home -->
        <a href="/home" class="mb-3 text-white fs-3 px-2 d-flex align-items-center text-decoration-none">
            <i class="fa-regular fa-house m-0"></i>
            <span class="d-none d-lg-inline ms-3">Home</span>
        </a>
    
        <!-- Profile -->
        <a href="/user/profile/" class="mb-3 text-white fs-3 px-2 d-flex align-items-center text-decoration-none">
            <i class="fa-regular fa-user m-0"></i>
            <span class="d-none d-lg-inline ms-3">Profile</span>
        </a>
    
        <!-- Post Button -->
        <button class="btn py-0 border-0 text-white fs-3 px-2 d-flex align-items-center mb-3" onclick="newPostTime()">
            <i class="fa-brands fa-twitter"></i>
            <span class="d-none d-lg-inline ms-3">Posts</span>
        </button>
    
        <!-- Search Button -->
        <button class="btn py-0 border-0 text-white fs-3 px-2 d-flex align-items-center mb-3"
            onclick="if(window.innerWidth >= 992) { document.querySelector('#searchBox')?.focus(); } else { new bootstrap.Offcanvas(document.getElementById('searchOffcanvas')).show(); }">
            <i class="fa-solid fa-magnifying-glass m-0"></i>
            <span class="d-none d-lg-inline ms-3">Search</span>
        </button>
    
        <!-- User Profile Section -->
        <div class="mt-auto mb-4 w-100">
            <div class="d-flex align-items-center justify-content-center justify-content-lg-between px-lg-2">
                <a href="/user/profile/<%= user?.username %>" class="flex-shrink-0">
                    <img src="<%= user?.profile_image !== null ? ('/'+user?.profile_image): 'https://upload.wikimedia.org/wikipedia/commons/0/03/Twitter_default_profile_400x400.png'%>"
                        alt="profile" class="rounded-circle border border-2 border-dark bg-dark"
                        style="width: 40px; height: 40px; object-fit: cover;">
                </a>
    
                <!-- Hide details on screens smaller than LG -->
                <div class="d-none d-lg-flex flex-column ms-2 overflow-hidden">
                    <span class="fw-bold text-white text-truncate" style="font-size: 0.9rem;">
                        <%= user?.name %>
                            <%= user?.lastname %>
                    </span>
                    <span class="text-secondary text-truncate" style="font-size: 0.8rem;">
                        @<%= user?.username %>
                    </span>
                </div>
    
                <!-- Logout Icon (Only on LG+) -->
                <a href="/auth/logout" class="ms-auto d-none d-lg-block text-primary">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </div>


<!-- Mobile Bottom Navigation Bar (visible below md) -->
<div class="mobile-bottom-nav">
    <a href="/home">
        <i class="fa-regular fa-house"></i>
    </a>
    <button type="button" data-bs-toggle="offcanvas" data-bs-target="#searchOffcanvas">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
    <button onclick="newPostTime()">
        <i class="fa-solid fa-plus"></i>
    </button>
    <a href="/user/profile/">
        <i class="fa-regular fa-user"></i>
    </a>
    <a href="/auth/logout">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
    </a>
</div>

<!-- Mobile Search Offcanvas (slides up from bottom) -->
<div class="offcanvas offcanvas-bottom bg-black text-white" tabindex="-1" id="searchOffcanvas" style="height: 85vh; border-radius: 20px 20px 0 0;">
    <div class="offcanvas-header border-bottom border-secondary px-3 pt-3 pb-2">
        <h5 class="offcanvas-title fw-bold"><i class="fa-solid fa-magnifying-glass me-2"></i>Search</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-3">
        <!-- Search Form -->
        <form class="form-inline mb-3" action="/home?" method="get" id="mobileSearchForm">
            <div class="form-floating form-group position-relative d-flex align-items-center">
                <i class="fa-solid fa-magnifying-glass text-secondary position-absolute ms-3" style="pointer-events: none; z-index: 5;"></i>
                <input type="text" class="form-control rounded-pill border-0 text-white ps-5 search-input" 
                    name="search" id="mobileSearchInput" placeholder="Search" 
                    style="background-color: #202327; height: 48px;" autofocus>
                <label for="mobileSearchInput" class="ps-5 text-secondary">Search X</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 rounded-pill mt-3 py-2 fw-bold">Search</button>
        </form>

        <!-- Search Results will appear here after form submit (page reloads) -->
        <% if (locals.searchUser && locals.searchUser.length > 0) { %>
        <div class="mt-3">
            <h6 class="fw-bold mb-3 text-secondary">Results</h6>
            <% locals.searchUser.forEach(sUser => { %>
            <div class="d-flex align-items-center mb-3 p-2 rounded-3" style="background-color: #16181c;">
                <a href="/user/profile/<%= sUser?.username %>" class="flex-shrink-0">
                    <img src="<%= sUser?.profile_image ? ('/' + sUser.profile_image) : 'https://upload.wikimedia.org/wikipedia/commons/0/03/Twitter_default_profile_400x400.png' %>"
                        alt="profile" class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover;">
                </a>
                <div class="ms-3 flex-grow-1 overflow-hidden">
                    <div class="fw-bold text-truncate">
                        <a class="text-white text-decoration-none" href="/user/profile/<%= sUser?.username %>">
                            <%= sUser?.name %> <%= sUser?.lastname %>
                        </a>
                    </div>
                    <div class="text-secondary small text-truncate">@<%= sUser?.username %></div>
                </div>
                <a href="/user/profile/<%= sUser?.username %>" class="btn btn-outline-light btn-sm rounded-pill fw-bold px-3 ms-2">View</a>
            </div>
            <% }) %>
        </div>
        <% } %>

        <!-- Trending Section (shown when no search) -->
        <% if (!locals.searchUser || locals.searchUser.length === 0) { %>
        <div class="mt-3">
            <div class="text-white p-3 rounded-4" style="background-color: #16181c;">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-fire text-danger me-2"></i>Trending topics</h6>
                <ul class="list-unstyled mb-0">
                    <li class="py-2 border-bottom border-secondary border-opacity-25">#Global-Heat</li>
                    <li class="py-2 border-bottom border-secondary border-opacity-25">#Climate_Change</li>
                    <li class="py-2 border-bottom border-secondary border-opacity-25">#Rupee-crash</li>
                    <li class="py-2 border-bottom border-secondary border-opacity-25">#Programming</li>
                    <li class="py-2">#TechNews</li>
                </ul>
            </div>
        </div>
        <% } %>
    </div>
</div>

<script>
    // Auto-open search offcanvas if search results exist on mobile
    document.addEventListener('DOMContentLoaded', function() {
        if (window.innerWidth < 992) {
            const searchUser = '<%= locals.searchUser ? "yes" : "" %>';
            if (searchUser) {
                const offcanvasEl = document.getElementById('searchOffcanvas');
                if (offcanvasEl) {
                    const bsOffcanvas = new bootstrap.Offcanvas(offcanvasEl);
                    bsOffcanvas.show();
                }
            }
        }
        // Auto-focus search input when offcanvas opens
        const searchOffcanvas = document.getElementById('searchOffcanvas');
        if (searchOffcanvas) {
            searchOffcanvas.addEventListener('shown.bs.offcanvas', function() {
                document.getElementById('mobileSearchInput')?.focus();
            });
        }
    });
</script>
