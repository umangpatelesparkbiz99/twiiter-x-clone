<!DOCTYPE html>
<html lang="en">
<%- include('../global/header') %>

  <body>

    <div class="container-fluid justify-content-between">
      <div class="container ">
        <div class="row">

          <%- include('../global/leftPannal') %>
          <!-- Added 'd-none d-lg-block' to hide on mobile/tablet -->
        

            <div class="col-lg-6 col-md-10 col-12 text-white d-flex flex-column mt-3 main-content-col">
            
              <h2>Home</h2>
              <hr class="mt-0">
              <% console.log(user.username); %>
              <!-- Insertion of twittes  -->
              <form action="/twitts/create" method="POST" enctype="multipart/form-data">
                <textarea name="content" id="newTwitt" class="form-control fs-4 bg-dark text-white" placeholder="What's happening?..." rows="2" maxlength="280" required></textarea>
                <div class="row d-flex justify-content-center align-items-center mt-2 ">
                  <div class="col fs-2 m-0">
                    <input type="file" name="feedPhoto" id="feedPhoto" hidden>
                    <label for="feedPhoto">
                      <i class="fa-regular fa-file-image"></i>
                    </label>
                  </div>
                  <div class="col d-flex ">
                    <button type="submit" class="btn btn-primary ms-auto">Tweet</button>
                  </div>
                  <p class=" m-0">6MB MAX </p>
                </div>
              </form>
              <hr>

              <% let count=0; %>
                <!-- Load all post here  -->
                <% all_feed.forEach(feed=> { %>

                  <div class="container-fluid">
                    <div class="container">

                      <!-- User info who post this twitt -->
                      <div class="row align-items-center text-white g-2">
                        <!-- 1. Profile Photo (Only takes space it needs) -->
                        <div class="col-auto">
                          <a href="/user/profile/<%= feed?.username %>">

                            <img src="<%= (feed?.profile_image)!== null ? (" /"+feed?.profile_image)
                              : 'https://upload.wikimedia.org/wikipedia/commons/0/03/Twitter_default_profile_400x400.png'
                              %>" alt="profile" class="rounded-circle border border-2 border-dark" style="width: 45px;
                            height: 45px; object-fit: cover;">
                          </a>
                        </div>

                        <!-- 2. Name and Username (Stays right next to photo) -->
                        <div class="col-auto d-flex flex-column lh-sm">
                          <span class="fw-bold small">
                            <a class="feedUser" href="/user/profile/<%= feed?.username %>">
                              <%= feed?.name %>
                                <%= feed?.lastname %>
                            </a>
                          </span>
                          <span class="text-secondary x-small" style="font-size: 0.85rem;">
                            <a href="/user/profile/<%= feed?.username %>" style="color: #6c757d;">

                              @<%= feed?.username %>
                            </a>
                          </span>
                          
                        </div>

                        <% if (feed.is_retweet) { %>
                       <div class="col">
                          <span>
                            <i class="fa-solid fa-retweet" style="color: green;"></i>
                          </span>
                        </div>
                        <% } %>

                        <!-- 3. Post Date (Pushed to the far end) -->
                        <div class="col text-end ms-auto">
                          
                          <div class="col-auto d-flex flex-column lh-sm">
                            <% if (user.username === feed.username) { %>
                              <span class="fw-bold small" id="trashIcon"
                              onclick="deletePost('<%= feed.tweet_uni_id  %>' )"><i
                              class="fa-solid fa-trash"></i></span>
                              
                            <% } %>
                            <span class="text-secondary small">
                              <%= new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' , timeStyle: 'short'
                                }).format(new Date(feed?.created_at));%>
                            </span>

                          </div>
                        </div>

                      </div>
                      <hr class="mt-1 ">

                      <!-- content of this twitt with img if provided -->
                      <div class="container d-flex flex-column">
                        <p>
                          <%= feed.content %>
                        </p>
                        <% if (feed.retweet_content) { %>
                         <p>
                           <%= feed.retweet_content  %>
                          </p>
                          <% if (feed.retweet_content_image) { %>
                          <div class="container d-flex justify-content-center feed-image-container">
                          
                            <img
                              src="<%= feed.retweet_content_image || 'https://images.unsplash.com/photo-1715146303917-835a41f452d0?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'%>"
                              alt="userPost" class="img-fluid object-fit-scale rounded mx-auto d-block">
                          </div>
                          <% } %>
                        <% } %>
                        <% if (feed?.content_image) { %>

                          <div class="container d-flex justify-content-center feed-image-container">

                            <img
                              src="<%= feed.content_image || 'https://images.unsplash.com/photo-1715146303917-835a41f452d0?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'%>"
                              alt="userPost" class="img-fluid object-fit-scale rounded mx-auto d-block">
                          </div>
                          <hr>
                          <% } %>

                      </div>
                      <!-- Like Comment Action Btn -->
                      <div class="container action-btn-row">
                        <div class="row">
                          <!-- Like Button -->
                          <div class="col-3 d-flex align-items-center">
                            <button type="button" class="btn fs-5 text-white d-flex align-items-center"
                              onclick="likeUnlikePost('<%= feed.tweet_uni_id %>','<%= user.uni_id %>','<%= count %>')">
                              <% if (feed.isLikedByUser) { %>
                                <i class="fa-solid fa-heart me-2 text-danger" id="liketweetIcn<%=count%>"></i>

                                <% } else { %>
                                  <i class="fa-regular fa-heart me-2" id="liketweetIcn<%=count%>"></i>
                                  <% } %>
                                    <span class="fs-6" id="liketweetCtn<%=count%>">
                                      <%= feed.total_likes %>
                                    </span>
                            </button>
                          </div>

                          <!-- Share Button -->
                          <div class="col-3 d-flex align-items-center">
                            <button type="button" class="btn fs-5 text-white d-flex align-items-center">
                              <i class="fa-regular fa-share-from-square me-2"></i>
                              <span class="fs-6">
                                0
                              </span>
                            </button>
                          </div>

                          <!-- Retweet Button -->
                           <% if (user.username !== feed.username) { %>
                            
                            <div class="col-3 d-flex align-items-center">
                              <button type="button" class="btn fs-5 text-white d-flex align-items-center"
                              onclick="document.location.href= '/twitts/<%= feed.tweet_uni_id %>/Retweet'">
                              <i class="fa-solid fa-retweet me-2"></i>
                              <span class="fs-6">
                                <%= feed.total_retweets %>
                              </span>
                            </button>
                          </div>
                          <% } %>

                          <!-- Comment Button -->
                          <div class="col-3 d-flex align-items-center">
                            <button type="button" class="btn fs-5 text-white d-flex align-items-center"
                              onclick="document.location.href= '/twitts/<%= feed.tweet_uni_id %>/comments'">
                              <i class="fa-regular fa-comment me-2"></i>
                              <span class="fs-6">
                                <%= feed.total_comments %>
                              </span>
                            </button>
                          </div>
                        </div>
                      </div>

                      <hr>
                    </div>

                  </div>
                  <% count++; }) %>

            </div>


            <%- include('../global/rightPannal') %>

        </div>
      </div>
    </div>
  </body>

</html>