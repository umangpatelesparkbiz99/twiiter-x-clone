<!DOCTYPE html>
<html lang="en">
<%- include('../global/header') %>

    <body>

        <body class="bg-dark">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <% if( error  ){ %>
                            <div class="alert alert-danger" role="alert">
                                <%= error %>
                            </div>
                        <% } %>
                        <form class="p-4 g-3 border rounded bg-black " onsubmit="validateRegisterCredentials(event)">

                            <!-- Center the logo only -->
                            <div class="text-center mb-4 ">
                                <i class="fa-brands fa-x-twitter fs-1 text-white "></i>
                            </div>
                            <a href="/auth/login" class="me-auto fs-3">Back</a>

                            <hr class="text-white">    
                            <div class="form-floating mb-3">
                                <input type="text" name="username" id="username" class="form-control" placeholder="Username" required />
                                <label for="username">Username</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="email" name="email" id="email" class="form-control" placeholder="Email"
                                    required />
                                <label for="email">Email</label>
                                <div class="invalid-feedback">
                                    Please choose a email.
                                </div>
                            </div>

                            <input type="hidden" name="uni_id" id="uni_id" value="<%= uni_id %>">

                            <div class="form-floating mb-3">
                                <input type="password" name="password" id="password" class="form-control"
                                    placeholder="Password" required />
                                <label for="password">Password</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control"
                                    placeholder="Confirm Password" required />
                                <label for="confirmPassword">Confirm Password</label>
                            </div>
                            <div class="mb-3">
                                <p id="error" style="display: none; color: white;"></p>
                            </div>

                            <!-- Flex container for buttons -->
                            <div class="d-flex flex-column">
                                <input type="reset" value="Reset" class="btn btn-secondary mb-2 py-3 x-btn" />
                                <input type="submit" value="Register" class="btn btn-primary py-3 x-btn" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </body>

</html>