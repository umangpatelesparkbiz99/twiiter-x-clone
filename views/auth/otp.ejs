    <!DOCTYPE html>
    <html lang="en">
    <%- include('../global/header.ejs') %>

        <body class="bg-dark">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <form class="p-4 border rounded bg-black" onsubmit="checkOtp(event,'<%= randomOtp %>')" method="post">

                            <!-- Center the logo only -->
                            <div class="text-center mb-4">
                                <i class="fa-brands fa-x-twitter fs-1 text-white"></i>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="text" name="otp" id="otp" class="form-control" placeholder="XXXXXX"  />
                                <label for="otp">otp</label>
                                <sub id="error" class="text-danger fs-6"></sub>
                            </div>

                            <div class="d-flex me-auto align-items-center justify-content-center text-white fs-3 mb-2 ">
                                <span id="timer"></span></div>


                            <!-- Flex container for buttons -->
                            <div class="d-flex flex-column">
                                <input type="reset" value="Reset" class="btn btn-secondary mb-2 x-btn py-3" />

                                <input type="submit" value="VERIFY" id="verify" class="btn btn-primary x-btn py-3" />
                                <a href="/auth/reset/<%= user %>" value="RESEND" id="resetbtn" class="btn btn-primary x-btn py-3" hidden>
                                    Resend 
                                </a>
                            </div>
                            <p class="mt-3 text-center text-white ">
                                Want to log-in?<a href="/auth/login"> Log-In</a>
                            </p>

                        </form>
                    </div>
                </div>
            </div>

            <script>
                const timer = document.getElementById("timer");
                let counter = 10;

                const intervalId = setInterval(() => {
                    timer.innerText = `${counter}`;

                    if (counter <= 0) {
                        const getResend= document.getElementById(`resetbtn`);
                        getResend.hidden = false;
                        const submit = document.getElementById(`verify`);
                        submit.hidden = true;
                        clearInterval(intervalId); 
                    } else {
                        counter--;
                    }
                }, 1000);

                async function checkOtp(e, orgOtp) {
                    e.preventDefault();
                    const timer = parseInt(document.getElementById('timer').innerText);
                    const otp = document.getElementById('otp').value;
                    

                    if (timer <= 0) {
                        const showError = document.getElementById('error');
                        showError.innerText = `time out`;
                        setTimeout(() => {
                            showError.style.display = `none`;
                        }, 2000);
                        return false;
                    }
                    if (otp === '' || orgOtp !== otp) {
                        const showError = document.getElementById('error');
                        showError.innerText = `otp is not match plz fill correct otp`;
                        setTimeout(() => {
                            showError.style.display = `none`;
                        }, 2000);
                        return false;
                    }

                    document.location.href="/auth/reset/<%= user %>/password";
                }

            </script>
        </body>

    </html>