<!DOCTYPE html>
<html lang="en">
<%- include('../global/header.ejs') %>

    <body class="bg-dark">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <form class="p-4 border rounded bg-black" onsubmit="validateNewPassword(event,'<%= user %>')">

                        <!-- Center the logo only -->
                        <div class="text-center mb-4">
                            <i class="fa-brands fa-x-twitter fs-1 text-white"></i>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" name="password" id="password" class="form-control" placeholder="Username"
                                required />
                            <label for="password">New password</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" name="repassword" id="repassword" class="form-control"
                                placeholder="re-Password" required />
                            <label for="repassword">Re Enter Password</label>
                            <sub id="error" class="text-danger fs-6 mt-1 mb-1"></sub>
                        </div>



                        <div class="mb-4">
                            <div class="d-flex flex-row justify-content-between align-items-center gap-3">

                                <!-- 1. The Captcha Image -->
                                <div id="captcha"
                                    class="bg-white rounded p-1 border flex-shrink-0 d-flex align-items-center justify-content-center"
                                    style="height: 45px; min-width: 120px;">
                                    <%- captchaPacket.data %>
                                </div>

                                <!-- 2. Refresh Button (Smaller and circular) -->
                                <button type="button"
                                    class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                    onclick="changeNewCaptcha()" style="width: 40px; height: 40px;">
                                    <i class="fa-solid fa-rotate-right"></i>
                                </button>

                                <!-- 3. The Input Field -->
                                <div class="form-floating flex-grow-1">
                                    <input type="text" name="inpCaptcha" id="inpCaptcha" class="form-control"
                                        placeholder="Enter Code" style="height: 45px;">
                                    <label for="inpCaptcha">Enter Code</label>
                                </div>
                            </div>

                            <!-- Error Message stays below -->
                            <div id="captchaError" class="text-danger small mt-2" style="display: none;">
                                <i class="fa-solid fa-circle-xmark"></i> Captcha does not match
                            </div>
                        </div>



                        <!-- Flex container for buttons -->
                        <div class="d-flex flex-column">
                            <input type="reset" value="Reset" class="btn btn-secondary mb-2 x-btn py-3" />

                            <input type="submit" value="Update" class="btn btn-primary x-btn py-3" />
                        </div>

                        <p class="mt-3 text-center text-white ">
                            Don't have an account?<a href="/auth/register"> Sign up</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>

        <script>
            let captchaString = `<%= captchaPacket.text %>`;

            async function changeNewCaptcha() {
                const captchaPacket = await fetch(`/services/captcha`);
                const newCaptcha = await captchaPacket.json();

                const oldCaptcha = document.getElementById('captcha');

                oldCaptcha.innerHTML = `${newCaptcha.data}`;
                captchaString = `${newCaptcha.text}`;
            }
        </script>
    </body>

</html>